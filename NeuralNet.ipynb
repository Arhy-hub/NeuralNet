    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "rand  = np.random.default_rng(42)\n",
    "\n",
    "a = sorted(rand.standard_normal(10))\n",
    "b = rand.integers(low=1,high=101,size=10)\n",
    "plt.plot(b,a)\n",
    "plt.show()\n"
   ]
